# Optional production storage. Required on serverless hosting for persistent
# accounts, sessions, credit hours, and bookings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional emails. The sender domain must be verified.
RESEND_API_KEY=
EMAIL_FROM="DojoMath <reservation@domaths.fr>"
CONTACT_FROM_EMAIL=
TEACHER_EMAIL=dojomath.contact@gmail.com
CONTACT_TO_EMAIL=dojomath.contact@gmail.com
DOJOMATH_MEET_LINK=https://meet.google.com/xxx-xxxx-xxx

# Stripe sends payment confirmations here:
# https://www.domaths.fr/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Server-only operational secrets. Never expose these with NEXT_PUBLIC_.
DOJOMATH_ADMIN_TOKEN=
REMINDER_SECRET=

# Public origin used by same-origin checks and SEO metadata.
NEXT_PUBLIC_SITE_URL=https://www.domaths.fr

# Public identity displayed on legal pages. Complete every field before
# accepting online payments in production.
NEXT_PUBLIC_CONTACT_EMAIL=dojomath.contact@gmail.com
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_STATUS=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_REGISTRATION=
NEXT_PUBLIC_PUBLICATION_DIRECTOR=
